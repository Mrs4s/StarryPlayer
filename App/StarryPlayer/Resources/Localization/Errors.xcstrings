{
  "sourceLanguage": "zh-Hans",
  "strings": {
    "playback.vipRequired": {
      "comment": "User-facing error. Inserted details are source diagnostics.",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该歌曲需要 VIP，或未登录"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This track requires VIP access, or you aren’t signed in."
          }
        }
      }
    },
    "playback.loginExpired": {
      "comment": "User-facing error. Inserted details are source diagnostics.",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登录已过期，请重新登录"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your session has expired. Please sign in again."
          }
        }
      }
    },
    "playback.unavailableInRegion": {
      "comment": "User-facing error. Inserted details are source diagnostics.",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该歌曲在当前地区不可用，可在设置的音乐平台页填写代理"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This track isn’t available in your region. You can configure a proxy in the music source’s settings."
          }
        }
      }
    },
    "playback.sourceUnreachable": {
      "comment": "User-facing error. Inserted details are source diagnostics.",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法连接到音乐来源"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t connect to the music source."
          }
        }
      }
    },
    "playback.assetExpired": {
      "comment": "User-facing error. Inserted details are source diagnostics.",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "播放地址已失效"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The playback URL has expired."
          }
        }
      }
    },
