    "language.title": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "界面语言"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Interface Language"
          }
        }
      }
    },
    "language.detail": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择界面使用的语言，立即生效"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose the interface language. Changes take effect immediately."
          }
        }
      }
    },
    "language.system": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "跟随系统"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "System Default"
          }
        }
      }
    },
    "group.launch": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启动"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Startup"
          }
        }
      }
    },
    "restorePlayback.title": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启动时恢复上次播放"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restore Playback on Launch"
          }
        }
      }
    },
    "restorePlayback.detail": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开应用时回到上次听的歌和进度，不会自动开始播放"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restore the last track and position when opening the app, without starting playback."
          }
        }
      }
    },
    "group.notch": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "刘海"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notch"
          }
        }
      }
    },
    "notch.title": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "刘海播放器"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notch Player"
          }
        }
      }
    },
    "notch.detail": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "播放时在屏幕顶部的刘海两侧显示封面和律动，指针移上去展开播放控制；没有刘海的屏幕显示在菜单栏中间"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show artwork and visualizations beside the notch during playback. Hover to reveal controls. On screens without a notch, show the player in the center of the menu bar."
          }
        }
      }
    },
    "notchLyrics.title": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示歌词"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show Lyrics"
          }
        }
      }
    },
    "notchLyrics.detail": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在刘海右侧（没有刘海的屏幕在中间）显示正在唱的那一句，会盖住那里的菜单栏图标"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show the current lyric beside the notch, or in the center on screens without one. It covers menu bar icons in that area."
          }
        }
      }
    },
    "notchHover.title": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "悬停展开"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Expand on Hover"
          }
        }
      }
    },
    "notchHover.detail": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "指针停在刘海上就展开；关闭后点按才展开"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Expand when the pointer rests on the notch. When off, click to expand."
          }
        }
      }
    },
    "notchNotchedOnly.title": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只在有刘海的屏幕上显示"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only on Screens with a Notch"
          }
        }
      }
    },
    "notchNotchedOnly.detail": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有刘海的 Mac 和外接显示器上不显示"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hide on Macs and external displays without a notch."
          }
        }
      }
    },
