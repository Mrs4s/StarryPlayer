            "value": "More detailed options"
          }
        }
      }
    },
    "advanced.help": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示歌词排版、背景细节、歌词来源顺序、代理等更细的选项"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show detailed lyrics layout, background, source priority, and proxy options"
          }
        }
      }
    },
    "advanced.tag": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "高级"
          }
        },
